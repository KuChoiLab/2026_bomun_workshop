        "#12-1. Run differential expression analysis (2min)\n",
        "%%R\n",
        "adipocyte <- subset(data,subset=cell_type=='Adipose cells')\n",
        "adipocyte <- JoinLayers(adipocyte)\n",
        "Idents(adipocyte) <- \"condition\"\n",
        "adipocyte_de <- FindMarkers(adipocyte,\n",
        "                                    ident.1 = \"Low BMI\",\n",
        "                                    ident.2 = \"High BMI\")"
      ],
