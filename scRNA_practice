    {
      "cell_type": "code",
      "source": [
        "#11-1. Create a frequency table of cell type vs condition and calculate percentages for each condition (< 1min)\n",
        "%%R\n",
        "data$condition <- ifelse(data$bmi <=25,'Low BMI','High BMI')\n",
        "counts <- as.data.frame(table(data$cell_type, data$condition))\n",
        "colnames(counts) <- c(\"Cell_type\", \"Condition\", \"Freq\")\n",
        "\n",
        "counts <- counts %>%\n",
        "  group_by(Condition) %>%\n",
        "  mutate(Percentage = (Freq / sum(Freq)) * 100)"
      ],
      "metadata": {
        "id": "dScSat6I6X6P"
      },
      "execution_count": null,
      "outputs": []
    },
