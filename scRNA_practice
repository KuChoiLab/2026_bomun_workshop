        "#12-2. Visualization via volcano plot (< 1min)\n",
        "%%R\n",
        "EnhancedVolcano(adipocyte_de,\n",
        "                lab = rownames(adipocyte_de),\n",
        "                x = 'avg_log2FC',\n",
        "                y = 'p_val_adj',\n",
        "                drawConnectors = TRUE)"
      ],
